// Cloudflare hosting settings. The site is plain files from ./dist (no server code).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "2ohair-site",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": true,
  "previews": {}
}
