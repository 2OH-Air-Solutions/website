---
import '@fontsource-variable/montserrat';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { business } from '../data/business';
import ogPhoto from '../assets/photos/room-sealed-top-plates-wide.jpg';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, business.url).href;
const og = await getImage({ src: ogPhoto, width: 1200, height: 630, format: 'jpg' });
const ogUrl = new URL(og.src, business.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: business.legalName,
  alternateName: [business.name, business.altName],
  url: business.url,
  logo: new URL('/logo.png', business.url).href,
  image: ogUrl,
  telephone: business.phoneE164,
  email: business.email,
  openingHours: business.hoursSchema,
  areaServed: [
    ...business.towns.washington.map((t) => ({ '@type': 'City', name: `${t}, WA` })),
    ...business.towns.idaho.map((t) => ({ '@type': 'City', name: `${t}, ID` })),
  ],
  description:
    'High-performance whole-house air sealing for new construction in Spokane and North Idaho.',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#061e52" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --navy: #061e52;
    --navy-2: #0c2c6e;
    --blue: #2b8bcb;
    --blue-dark: #1d6fa8;
    --sky: #5bb8e8;
    --pale: #b5def4;
    --mist: #eef6fc;
    --ink: #13203b;
    --muted: #4a5670;
    --line: #dbe5ef;
    --white: #ffffff;
    --radius: 14px;
    --max: 1160px;
    --font: 'Montserrat Variable', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
  }
  body {
    margin: 0;
    font-family: var(--font);
    font-size: 18px;
    line-height: 1.65;
    color: var(--ink);
    background: var(--white);
  }
  img {
    max-width: 100%;
    height: auto;
    display: block;
  }
  h1,
  h2,
  h3 {
    color: var(--navy);
    line-height: 1.2;
    margin: 0 0 0.6em;
    letter-spacing: -0.01em;
  }
  h1 {
    font-size: clamp(2rem, 4.6vw, 3.25rem);
    font-weight: 800;
  }
  h2 {
    font-size: clamp(1.6rem, 3.2vw, 2.25rem);
    font-weight: 800;
  }
  h3 {
    font-size: 1.25rem;
    font-weight: 700;
  }
  p {
    margin: 0 0 1em;
  }
  a {
    color: var(--blue-dark);
    text-underline-offset: 3px;
  }
  a:focus-visible,
  button:focus-visible,
  input:focus-visible,
  textarea:focus-visible {
    outline: 3px solid var(--sky);
    outline-offset: 2px;
  }
  .wrap {
    width: 100%;
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 20px;
  }
  .section {
    padding: clamp(48px, 8vw, 96px) 0;
  }
  .section--mist {
    background: var(--mist);
  }
  .eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blue-dark);
    margin-bottom: 0.75rem;
  }
  .lead {
    font-size: 1.15rem;
    color: var(--muted);
    max-width: 62ch;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 52px;
    padding: 0.8rem 1.5rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    border: 2px solid transparent;
    cursor: pointer;
    font-family: inherit;
  }
  .btn--primary {
    /* Darker than the logo blue so white button text is easy to read. */
    background: var(--blue-dark);
    color: var(--white);
  }
  .btn--primary:hover {
    background: var(--navy-2);
  }
  .btn--ghost {
    border-color: currentColor;
    color: var(--navy);
    background: transparent;
  }
  .btn--light {
    background: var(--white);
    color: var(--navy);
  }
  .btn-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .grid {
    display: grid;
    gap: 24px;
  }
  @media (min-width: 760px) {
    .grid--2 {
      grid-template-columns: repeat(2, 1fr);
    }
    .grid--3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px;
  }
  .stripes {
    position: relative;
    overflow: hidden;
  }
  .stripes::after {
    content: '';
    position: absolute;
    top: -20%;
    right: -60px;
    width: 220px;
    height: 140%;
    background: linear-gradient(
      90deg,
      var(--navy) 0 22%,
      transparent 22% 30%,
      var(--sky) 30% 52%,
      transparent 52% 60%,
      var(--pale) 60% 82%,
      transparent 82%
    );
    transform: skewX(-22deg);
    opacity: 0.9;
    pointer-events: none;
  }
  @media (max-width: 760px) {
    .stripes::after {
      top: auto;
      bottom: 0;
      right: -30px;
      width: 110px;
      height: 56px;
      opacity: 0.85;
    }
  }
  .skip {
    position: absolute;
    left: -999px;
    top: 0;
    background: var(--navy);
    color: var(--white);
    padding: 10px 16px;
    z-index: 100;
  }
  .skip:focus {
    left: 10px;
  }
  .checklist {
    list-style: none;
    padding: 0;
    margin: 0 0 1em;
  }
  .checklist li {
    position: relative;
    padding-left: 32px;
    margin-bottom: 0.6em;
  }
  .checklist li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 18px;
    height: 10px;
    border-left: 3px solid var(--blue);
    border-bottom: 3px solid var(--blue);
    transform: rotate(-45deg);
  }
</style>
