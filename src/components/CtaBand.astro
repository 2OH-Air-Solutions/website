---
import { business } from '../data/business';
interface Props {
  heading?: string;
}
const { heading = 'Planning a build? Let’s talk air sealing.' } = Astro.props;
---

<section class="cta stripes">
  <div class="wrap inner">
    <h2>{heading}</h2>
    <p>Tell us about your project and your airtightness target, and we’ll get back to you with a quote.</p>
    <div class="btn-row">
      <a class="btn btn--light" href={business.phoneHref}>Call {business.phone}</a>
      <a class="btn btn--primary" href="/contact/">Request a quote</a>
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--navy-2);
    color: #dce6f5;
    padding: clamp(48px, 7vw, 80px) 0;
  }
  .inner {
    position: relative;
    z-index: 1;
    max-width: 860px;
    margin-left: max(0px, calc((100% - var(--max)) / 2));
  }
  h2 {
    color: var(--white);
  }
  p {
    font-size: 1.1rem;
    margin-bottom: 1.5em;
  }
</style>
