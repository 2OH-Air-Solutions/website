---
import logo from '../assets/logo.svg?url';
import { business } from '../data/business';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/services/', label: 'Services' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="2.0 Air home">
      <img src={logo} alt="2.0 Air" width="186" height="37" />
    </a>
    <nav aria-label="Main">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={path === l.href.replace(/\/$/, '') ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="btn btn--primary call" href={business.phoneHref}>
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"
        ><path
          d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"
        ></path></svg
      >
      <span class="call-text">{business.phone}</span>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.97);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 72px;
  }
  .brand img {
    height: 30px;
    width: auto;
  }
  nav {
    margin-left: auto;
  }
  nav ul {
    list-style: none;
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    color: var(--navy);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    border-radius: 8px;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    background: var(--mist);
  }
  .call {
    min-height: 44px;
    padding: 0.5rem 1rem;
    font-size: 0.95rem;
  }
  @media (max-width: 720px) {
    .bar {
      flex-wrap: wrap;
      gap: 6px 12px;
      padding-top: 10px;
      padding-bottom: 6px;
    }
    .brand img {
      height: 24px;
    }
    .call {
      margin-left: auto;
      padding: 0.45rem 0.9rem;
      font-size: 0.9rem;
    }
    nav {
      order: 3;
      width: 100%;
      margin-left: -12px;
    }
  }
</style>
