---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { business } from '../data/business';
import hero from '../assets/photos/room-sealed-top-plates-wide.jpg';
import seams from '../assets/photos/liquid-applied-seams-top-plate.jpg';
import sill from '../assets/photos/sill-plate-corner-sealed.jpg';
import ceiling from '../assets/photos/ceiling-penetrations-sealed.jpg';
---

<Base
  title="Air Sealing in Spokane & North Idaho | 2.0 Air"
  description="High-performance whole-house air sealing for new construction in Spokane and North Idaho. Pre-drywall, post-drywall, or both. Insured and bonded."
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Serving Spokane &amp; North Idaho</span>
        <h1>High-performance whole-house air sealing for new construction</h1>
        <p class="lead">
          Pre-drywall and post-drywall air sealing for builders and homeowners, planned around each project’s airtightness target.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/contact/">Request a quote</a>
          <a class="btn btn--ghost" href={business.phoneHref}>Call {business.phone}</a>
        </div>
        <p class="trust">Insured and bonded</p>
      </div>
      <div class="hero-photo">
        <Image
          src={hero}
          alt="Framed room with blue liquid-applied sealant along the top plates, around windows and a patio door"
          widths={[480, 800, 1200]}
          sizes="(min-width: 960px) 560px, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class="section section--mist">
    <div class="wrap why">
      <div>
        <span class="eyebrow">About our name</span>
        <h2>A name built on airtightness</h2>
        <p>
          Our name refers to <strong>2.0 ACH</strong>, a high-performance airtightness benchmark. Every project has its own target, whether 3.0, 2.0, 1.5, or another value, and our work is planned around the target your project requires.
        </p>
      </div>
      <div class="card explain">
        <h3>Understanding ACH50</h3>
        <p>
          ACH50 is how many times a house’s air is replaced per hour during a blower door test, at a pressure similar
          to a 20–25 mph wind. Lower is tighter.
        </p>
        <p class="note">
          Blower door testing is performed by a third party, such as the builder’s energy rater. 2.0 Air provides the air sealing.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Services</span>
      <h2>Air sealing for new construction</h2>
      <div class="grid grid--3 services">
        <article class="card">
          <span class="num">1</span>
          <h3>Pre-Drywall Air Sealing</h3>
          <p>Air sealing performed while the framing is open, before drywall is installed.</p>
        </article>
        <article class="card">
          <span class="num">2</span>
          <h3>Post-Drywall Air Sealing</h3>
          <p>Air sealing performed after drywall is installed.</p>
        </article>
        <article class="card">
          <span class="num">3</span>
          <h3>Drywall Air Sealing</h3>
          <p>Drywall sealing as a standalone service, available to select builders.</p>
        </article>
      </div>
      <div class="strip">
        <Image src={seams} alt="Blue liquid-applied sealant over wall sheathing seams and along a top plate" widths={[400, 700]} sizes="(min-width: 760px) 360px, 100vw" />
        <Image src={ceiling} alt="Vent pipe, drain pipe, and wire sealed where they pass through a top plate" widths={[400, 700]} sizes="(min-width: 760px) 360px, 100vw" />
        <Image src={sill} alt="Sealant along the bottom plate and corner framing of an exterior wall" widths={[400, 700]} sizes="(min-width: 760px) 360px, 100vw" />
      </div>
      <p class="more"><a href="/services/">View services and materials →</a></p>
    </div>
  </section>

  <section class="section section--mist">
    <div class="wrap grid grid--2">
      <div>
        <span class="eyebrow">Who we work with</span>
        <h2>Builders and homeowners</h2>
        <p>
          We work with home builders and homeowners on new construction. Share your project’s airtightness target, and we will plan the air sealing around it.
        </p>
        <ul class="checklist">
          <li>Whole-house air sealing for new construction</li>
          <li>Liquid-applied air barrier, caulk, and foam</li>
          <li>Insured and bonded</li>
        </ul>
      </div>
      <div>
        <span class="eyebrow">Service area</span>
        <h2>Spokane and North Idaho</h2>
        <div class="towns">
          <div>
            <h3>Washington</h3>
            <ul>{business.towns.washington.map((t) => <li>{t}</li>)}</ul>
          </div>
          <div>
            <h3>Idaho</h3>
            <ul>{business.towns.idaho.map((t) => <li>{t}</li>)}</ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero {
    padding: clamp(32px, 6vw, 72px) 0;
    background: linear-gradient(180deg, var(--mist), var(--white));
  }
  .hero-grid {
    display: grid;
    gap: 32px;
    align-items: center;
  }
  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: 1.05fr 1fr;
      gap: 48px;
    }
  }
  .hero-photo :global(img) {
    border-radius: var(--radius);
    box-shadow: 0 18px 40px rgba(6, 30, 82, 0.18);
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .trust {
    margin-top: 1.25rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--muted);
  }
  .why {
    display: grid;
    gap: 32px;
    align-items: start;
  }
  @media (min-width: 860px) {
    .why {
      grid-template-columns: 1.1fr 1fr;
    }
  }
  .explain .note {
    font-size: 0.95rem;
    color: var(--muted);
    margin: 0;
  }
  .services {
    margin-top: 24px;
  }
  .num {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--navy);
    color: var(--white);
    font-weight: 800;
    margin-bottom: 14px;
  }
  .strip {
    display: grid;
    gap: 16px;
    margin-top: 28px;
  }
  @media (min-width: 760px) {
    .strip {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .strip :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .more {
    margin-top: 20px;
    font-weight: 700;
  }
  .towns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .towns h3 {
    font-size: 1rem;
    margin-bottom: 0.4em;
  }
  .towns ul {
    margin: 0;
    padding-left: 1.1em;
  }
</style>
