---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import wide from '../assets/photos/framed-wall-sealed-plates-windows.jpg';
import seams from '../assets/photos/liquid-applied-seams-top-plate.jpg';
import pipe from '../assets/photos/pipe-penetration-closeup.jpg';
import pipeSill from '../assets/photos/pipe-penetration-sealed-sill.jpg';
import plumbing from '../assets/photos/plumbing-floor-penetrations.jpg';
import attic from '../assets/photos/attic-duct-boot-foam.jpg';

const gallery = [
  { src: seams, alt: 'Blue liquid-applied sealant over sheathing seams and along a top plate' },
  { src: pipe, alt: 'Close-up of a pipe sealed where it passes through a wall plate' },
  { src: pipeSill, alt: 'Pipe sealed with gray sealant where it passes through framing' },
  { src: plumbing, alt: 'Plumbing penetrations through the floor sealed with foam' },
  { src: attic, alt: 'Foam sealing around a duct penetration' },
];
---

<Base
  title="Pre- & Post-Drywall Air Sealing Services | 2.0 Air"
  description="Whole-house air sealing for new homes in Spokane and North Idaho: pre-drywall, post-drywall, and drywall air sealing for certain builders."
>
  <section class="section intro">
    <div class="wrap intro-grid">
      <div>
        <span class="eyebrow">Services</span>
        <h1>Whole-house air sealing for new construction</h1>
        <p class="lead">
          2.0 Air provides whole-house air sealing for new homes in Spokane and North Idaho, planned around the airtightness target each project requires.
        </p>
      </div>
      <Image
        src={wide}
        alt="Framed wall with blue sealant along the top plate and around window openings"
        widths={[420, 700]}
        sizes="(min-width: 900px) 420px, 100vw"
        class="intro-photo"
      />
    </div>
  </section>

  <section class="section section--mist">
    <div class="wrap">
      <h2>Our services</h2>
      <div class="grid grid--3">
        <article class="card" id="pre-drywall">
          <h3>Pre-Drywall Air Sealing</h3>
          <p>Air sealing performed while the framing is open, before drywall is installed.</p>
        </article>
        <article class="card" id="post-drywall">
          <h3>Post-Drywall Air Sealing</h3>
          <p>Air sealing performed after drywall is installed.</p>
        </article>
        <article class="card" id="drywall-air-sealing">
          <h3>Drywall Air Sealing</h3>
          <p>
            Drywall sealing as a standalone service, available to select builders.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid grid--2">
      <div>
        <h2>Materials</h2>
        <ul class="checklist">
          <li>
            <strong>Liquid-applied air barrier.</strong> A sealant applied wet over seams and joints.
          </li>
          <li><strong>Caulk and foam.</strong> For gaps and penetrations.</li>
          <li>
            <strong>Sill sealer.</strong> A foam gasket installed beneath the plates, included as part of whole-house air sealing.
          </li>
        </ul>
      </div>
      <div>
        <h2>Airtightness targets</h2>
        <p>
          Every project has its own airtightness target, such as 3.0, 2.0, or 1.5 ACH. Share your target, and we will plan the air sealing around it.
        </p>
        <p>
          Blower door testing is performed by a third party, such as the builder’s energy rater.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--mist">
    <div class="wrap">
      <h2>Project photos</h2>
      <div class="gallery">
        {
          gallery.map((g) => (
            <Image src={g.src} alt={g.alt} widths={[360, 600]} sizes="(min-width: 760px) 360px, 100vw" />
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand heading="Request a quote" />
</Base>

<style>
  .intro-grid {
    display: grid;
    gap: 32px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .intro-grid {
      grid-template-columns: 1.4fr 1fr;
    }
  }
  .intro-grid :global(.intro-photo) {
    border-radius: var(--radius);
    width: 100%;
    max-height: 460px;
    object-fit: cover;
  }
  .gallery {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  }
  .gallery :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius);
  }
</style>
