---
import Base from '../layouts/Base.astro';
import { business } from '../data/business';
---

<Base
  title="Thank You | 2.0 Air"
  description="Thank you for contacting 2.0 Air. We have received your message and will follow up."
  noindex
>
  <section class="section">
    <div class="wrap narrow">
      <h1>Thank you for your message</h1>
      <p class="lead">We have received your message and will follow up.</p>
      <p>
        For faster assistance, call <a href={business.phoneHref}>{business.phone}</a>, {business.hours}.
      </p>
      <p><a class="btn btn--primary" href="/">Return to the home page</a></p>
    </div>
  </section>
</Base>

<style>
  .narrow {
    max-width: 720px;
  }
</style>
