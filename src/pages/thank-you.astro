---
import Base from '../layouts/Base.astro';
import { business } from '../data/business';
---

<Base
  title="Thanks for your message | 2.0 Air"
  description="Thanks for contacting 2.0 Air. We received your message and will get back to you."
  noindex
>
  <section class="section">
    <div class="wrap narrow">
      <h1>Thanks! Your message was sent.</h1>
      <p class="lead">We received your message and will get back to you.</p>
      <p>
        Need us sooner? Call <a href={business.phoneHref}>{business.phone}</a>, {business.hours}.
      </p>
      <p><a class="btn btn--primary" href="/">Back to the home page</a></p>
    </div>
  </section>
</Base>

<style>
  .narrow {
    max-width: 720px;
  }
</style>
